#!/bin/bash
# AIMIP host wrapper — generated by install/install-container.sh (values below are filled at install time; do not edit
# by hand, re-run install-container.sh instead). Runs the `aimip` CLI inside the container image; mounts paths
# read-only except the run directory, the caller's run root, and (when writable) the data directory.
set -u
export LC_ALL=C   # stable `ls -ld` mode columns for the permission checks below
umask g-w,o-w     # run directories created through the wrapper must pass trusted_dir even for users with umask 002
PREFIX=@PREFIX@
RUNTIME=@RUNTIME@            # apptainer | singularity | docker | podman
RUNTIME_BIN=@RUNTIME_BIN@
IMAGE=@IMAGE@                # SIF path or docker/podman tag
SCHEDULER=@SCHEDULER@        # slurm | none
RUN_ROOT_TEMPLATE='@RUN_ROOT@'
EXTRA_RO="@EXTRA_RO@"
DATA=$PREFIX/data
U=$(id -un); U1=${U:0:1}
RUN_ROOT=${RUN_ROOT_TEMPLATE//'${USER}'/$U}; RUN_ROOT=${RUN_ROOT//'${U1}'/$U1}; RUN_ROOT=${RUN_ROOT//'${HOME}'/$HOME}

die() { echo "aimip: $*" >&2; exit 2; }
safe_path() {
  case "$1" in /*) ;; *) die "path must be absolute: $1";; esac
  case "$1" in *..*|*[!A-Za-z0-9._/+-]*) die "refusing path: $1";; esac
}
trusted_dir() {  # a run directory read again at job time must be the caller's own, a real directory, not group/world-writable
  local d=$1 m
  [ -L "$d" ] && die "refusing a symlinked run directory: $d"
  [ -d "$d" ] || die "not a directory: $d"
  [ -O "$d" ] || die "run directory is not owned by you: $d"
  m=$(ls -ld "$d" | cut -c1-10)
  case "${m:5:1}${m:8:1}" in *w*) die "run directory is group- or world-writable ($m): $d — fix with: chmod go-w $d";; esac
  for f in job.sbatch config.yaml aimip-manifest.json spin-manifest.json slurm.jobid sacct.txt local.pid local-run.log ic_members.nc ic_members_atmosphere.nc ic_members_ocean.nc; do
    [ -L "$d/$f" ] && die "refusing symlinked $d/$f"
    [ -e "$d/$f" ] || continue
    [ -O "$d/$f" ] || die "$d/$f is not owned by you"
    m=$(ls -ld "$d/$f" | cut -c1-10)
    case "${m:5:1}${m:8:1}" in *w*) die "$d/$f is group- or world-writable ($m) — fix with: chmod go-w $d/$f";; esac
  done
  # ancestry: no directory above the run dir may let others rename it away (group/world-writable without sticky bit)
  check_ancestry "$d"
  # check the resolved physical path too so a symlink in the path cannot lead into a shared writable tree
  local phys; phys=$(cd "$d" 2>/dev/null && pwd -P) || die "cannot resolve $d"
  [ "$phys" = "$d" ] || check_ancestry "$phys"
  return 0
}
check_ancestry() {
  local a=$1 o m
  while a=$(dirname "$a"); [ "$a" != / ]; do
    if [ -L "$a" ]; then   # system links (e.g. /var -> /private/var) are fine; a link owned by another user is not
      o=$(ls -ld "$a" | awk '{print $3}'); [ "$o" = root ] || [ "$o" = "$U" ] || die "a symlink owned by $o is in the run directory path: $a"
      continue
    fi
    m=$(ls -ld "$a" | cut -c1-10)
    case "${m:5:1}${m:8:1}" in *w*) case "${m:9:1}" in t|T) ;; *) die "a parent directory is writable by others without sticky bit ($m): $a";; esac;; esac
  done
  return 0
}
write_in_dir() {  # write_in_dir <trusted dir> <name> <content>: tmp + mv, never through a symlink
  local t; t=$(mktemp "$1/.$2.XXXXXX") || die "cannot write in $1"; printf '%s\n' "$3" > "$t"; mv -f "$t" "$1/$2"
}
check_job_script() {  # the job script must match the exact shape generated by aimip (literal comparison, no regex on $PREFIX)
  local f=$1 d=$2 n=0 execs=0 line rest log_rel log_pfx log_sfx cand cand_mid
  local want_exec="\"$PREFIX/bin/aimip\" exec-fme \""
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n+1))
    if [ $n = 1 ]; then [ "$line" = "#!/bin/bash" ] || die "line 1 must be #!/bin/bash"; continue; fi
    if [ $n = 2 ]; then [ "$line" = "# aimip-generated v1" ] || die "$f is not an aimip-generated script"; continue; fi
    case "$line" in
      "") ;;
      "set -euo pipefail") ;;
      "#SBATCH --hint=nomultithread") ;;   # one task CPU per physical core; no other --hint value is generated
      "#SBATCH --"*)
        rest=${line#"#SBATCH --"}
        case "$rest" in *=*) ;; *) die "unexpected #SBATCH line: $line";; esac
        case "${rest%%=*}" in job-name|partition|account|gres|cpus-per-task|mem|time|output|error) ;; *) die "unexpected #SBATCH line: $line";; esac
        case "${rest#*=}" in ""|*..*|*[!A-Za-z0-9._/:%+-]*) die "unexpected #SBATCH value: $line";; esac
        case "${rest%%=*}" in output|error)
          case "${rest#*=}" in "$d"/*) ;; *) die "slurm log outside the run directory: $line";; esac
          log_rel=${rest#*=}; log_rel=${log_rel#"$d"/}
          case "$log_rel" in ""|.|*/*) die "slurm log must be a file directly in the run directory: $line";; esac
          [ -L "$d/$log_rel" ] && die "refusing symlinked slurm log: $d/$log_rel"
          [ -d "$d/$log_rel" ] && die "slurm log destination is a directory: $d/$log_rel"
          case "$log_rel" in
            *%*)
              case "$log_rel" in *%j*) ;; *) die "unsupported slurm log substitution: $line";; esac
              log_pfx=${log_rel%%"%j"*}; log_sfx=${log_rel#*"%j"}
              case "$log_pfx$log_sfx" in *%*) die "unsupported slurm log substitution: $line";; esac
              for cand in "$d/$log_pfx"*"$log_sfx"; do
                [ -L "$cand" ] || [ -e "$cand" ] || continue
                cand_mid=${cand#"$d/$log_pfx"}; cand_mid=${cand_mid%"$log_sfx"}
                case "$cand_mid" in ""|*[!0-9]*) continue;; esac
                [ -L "$cand" ] && die "refusing symlinked slurm log: $cand"
                [ -d "$cand" ] && die "slurm log destination is a directory: $cand"
              done;;
          esac;;
        esac;;
      "$want_exec"*)
        rest=${line#"$want_exec"}
        case "$rest" in /*\") ;; *) die "unexpected exec line: $line";; esac
        rest=${rest%\"}; safe_path "$rest"
        [ "$rest" = "$d" ] || case "$rest" in "$d"/*) ;; *) die "exec target outside the run directory: $rest";; esac
        execs=$((execs+1));;
      *) die "$f has an unexpected line: $line";;
    esac
  done < "$f"
  [ $execs -ge 1 ] || die "$f has no exec-fme line"
}

# ---------------- host-side commands ----------------
if [ "${1:-}" = "submit" ]; then
  D=${2:-}; [ -n "$D" ] || die "usage: aimip submit <run-dir>"
  safe_path "$D"; D=${D%/}; trusted_dir "$D"
  [ -f "$D/job.sbatch" ] || die "$D has no job.sbatch (prepare it with: aimip run ... --out $D)"
  [ -e "$D/slurm.jobid" ] || [ -e "$D/local.pid" ] && die "already submitted"
  # Copy into a fresh caller-private 0700 directory, validate the copy, and submit the copy so the checked file
  # cannot be swapped before sbatch or bash reads it.
  PD=$(mktemp -d "${TMPDIR:-/tmp}/aimip-submit.XXXXXX") || die "cannot create a private directory"
  chmod 700 "$PD"; T=$PD/job.sbatch; trap 'rm -rf "$PD"' EXIT
  cat "$D/job.sbatch" > "$T" || die "cannot read $D/job.sbatch"; chmod 400 "$T"
  check_job_script "$T" "$D"
  if [ "$SCHEDULER" = slurm ]; then
    out=$(sbatch --parsable "$T") || { rm -rf "$PD"; die "sbatch failed"; }
    rm -rf "$PD"
    write_in_dir "$D" slurm.jobid "${out%%;*}"; echo "submitted job ${out%%;*}   (then: aimip status $D)"
  else
    trap - EXIT   # local runs execute the private copy in the background until completion
    [ -L "$D/local-run.log" ] && die "refusing symlinked $D/local-run.log"
    nohup bash "$T" > "$D/local-run.log" 2>&1 & write_in_dir "$D" local.pid "$!"; echo "started locally, pid $(cat "$D/local.pid")   (log: $D/local-run.log)"
  fi
  exit 0
fi
if [ "${1:-}" = "status" ] && [ -n "${2:-}" ] && [ "$SCHEDULER" = slurm ] && [ -f "$2/slurm.jobid" ]; then
  safe_path "$2"
  if ( trusted_dir "${2%/}" ) 2>/dev/null; then   # only refresh sacct.txt in a directory that is safely the caller's
    j=$(tr -dc '0-9' < "$2/slurm.jobid")
    if [ -n "$j" ]; then
      sa=$(sacct -n -X -P -j "$j" -o JobID,State,Elapsed,ExitCode 2>/dev/null)
      [ -n "$sa" ] && write_in_dir "${2%/}" sacct.txt "$sa"   # keep the last good record if sacct answers nothing
    fi
  fi
fi

# ---------------- container commands ----------------
RW=()
args=("$@"); n=${#args[@]}
for ((i=0; i<n; i++)); do
  case "${args[$i]}" in
    --out|--ocean-out) [ $((i+1)) -lt $n ] && RW+=("${args[$((i+1))]}");;
    --out=*) RW+=("${args[$i]#--out=}");;
    --ocean-out=*) RW+=("${args[$i]#--ocean-out=}");;
  esac
done
case "${1:-}" in exec-fme|status|summary|collect) [ -n "${2:-}" ] && RW+=("$2");; esac
# At job time the run directory is read again (config.yaml, manifest): verify it is still safely the caller's.
[ "${1:-}" = "exec-fme" ] && { [ -n "${2:-}" ] || die "usage: aimip exec-fme <run-dir>"; safe_path "$2"; trusted_dir "${2%/}"; }
mkdir -p "$RUN_ROOT" 2>/dev/null || true

declare -a MOUNTS=()   # "src:dst:mode"
MOUNTS+=("$PREFIX:$PREFIX:ro")
# data: rw for setup/fetch, and for run/ic (fetch on first use) when the caller may write it;
# non-writable callers see it read-only and are told to have `aimip fetch -m <model>` run first.
DATA_MODE=ro
case "${1:-}" in
  setup|fetch) mkdir -p "$DATA" 2>/dev/null; [ -w "$DATA" ] || die "$DATA is not writable by you: ask the install owner to run this"; DATA_MODE=rw;;
  run|ic) [ -w "$DATA" ] && DATA_MODE=rw;;
esac
[ -d "$DATA" ] && [ $DATA_MODE = rw ] && MOUNTS+=("$DATA:$DATA:rw")
[ -d "$RUN_ROOT" ] && MOUNTS+=("$RUN_ROOT:$RUN_ROOT:rw")
for e in $EXTRA_RO; do [ -d "$e" ] && MOUNTS+=("$e:$e:ro"); done
for d in ${RW[@]+"${RW[@]}"}; do
  safe_path "$d"
  case "$d" in "$RUN_ROOT"/*) continue;; esac
  base=$d; [ -e "$base" ] || base=$(dirname "$base"); mkdir -p "$base" 2>/dev/null || true
  [ -w "$base" ] || die "not writable: $base"
  MOUNTS+=("$base:$base:rw")
done
KEYENV=(); KEYNAMES=()   # credentials are forwarded only for `chat`, and never as KEY=value in argv
if [ "${1:-}" = "chat" ]; then
  for v in AIMIP_AGENT_MODEL AIMIP_GEMINI_VERTEX_PROJECT AIMIP_GEMINI_VERTEX_LOCATION; do
    [ -n "${!v:-}" ] && KEYENV+=("$v=${!v}")
  done
  for k in GEMINI_API_KEY GOOGLE_API_KEY; do
    [ -n "${!k:-}" ] || continue
    KEYNAMES+=("$k"); export "APPTAINERENV_$k=${!k}" "SINGULARITYENV_$k=${!k}"
  done
  if [ -n "${AIMIP_GEMINI_KEY_FILE:-}" ]; then safe_path "$AIMIP_GEMINI_KEY_FILE"
    [ -f "$AIMIP_GEMINI_KEY_FILE" ] && [ ! -L "$AIMIP_GEMINI_KEY_FILE" ] && [ -O "$AIMIP_GEMINI_KEY_FILE" ] \
      || die "AIMIP_GEMINI_KEY_FILE must be an existing regular file owned by you: $AIMIP_GEMINI_KEY_FILE"
    MOUNTS+=("$AIMIP_GEMINI_KEY_FILE:$AIMIP_GEMINI_KEY_FILE:ro"); KEYENV+=("AIMIP_GEMINI_KEY_FILE=$AIMIP_GEMINI_KEY_FILE"); fi
  for f in AIMIP_GEMINI_VERTEX_TOKEN_FILE GOOGLE_APPLICATION_CREDENTIALS; do
    [ -n "${!f:-}" ] || continue; safe_path "${!f}"
    [ -f "${!f}" ] && [ ! -L "${!f}" ] && [ -O "${!f}" ] || die "$f must be an existing regular file owned by you: ${!f}"
    MOUNTS+=("${!f}:${!f}:ro"); KEYENV+=("$f=${!f}")
  done
fi
IMG_SHA=$(cut -c1-64 "$PREFIX/image.sha256" 2>/dev/null || echo unknown)
ENVS=("AIMIP_HOME=$PREFIX" "AIMIP_PLAYGROUND=$PREFIX" "AIMIP_DATA=$DATA" "AIMIP_IMAGE_SHA=$IMG_SHA" "AIMIP_DEFAULT_OUT_ROOT=$RUN_ROOT"
      "AIMIP_USER=$U" "AIMIP_SCHEDULER=$SCHEDULER" "AIMIP_SITE_CONFIG=$PREFIX/site.json" "AIMIP_EXTRA_RO_BINDS=$EXTRA_RO" "AIMIP_DATA_MODE=$DATA_MODE" "AIMIP_CHAT_LOG_DIR=$RUN_ROOT/chat-logs" "HOME=/tmp" "HF_HOME=$DATA/.hf" "OMP_NUM_THREADS=${OMP_NUM_THREADS:-16}" ${KEYENV[@]+"${KEYENV[@]}"})

GPU=0; command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1 && GPU=1
case "$RUNTIME" in
  apptainer|singularity)
    B=(); for m in ${MOUNTS[@]+"${MOUNTS[@]}"}; do B+=(-B "$m"); done
    E=(); for v in ${ENVS[@]+"${ENVS[@]}"}; do E+=(--env "$v"); done
    NV=(); [ $GPU = 1 ] && NV=(--nv)
    exec "$RUNTIME_BIN" -s exec ${NV[@]+"${NV[@]}"} --containall --cleanenv --no-home --pwd /tmp ${B[@]+"${B[@]}"} ${E[@]+"${E[@]}"} "$IMAGE" python -B -m aimip "$@";;
  docker|podman)
    B=(); for m in ${MOUNTS[@]+"${MOUNTS[@]}"}; do B+=(-v "$m"); done
    E=(); for v in ${ENVS[@]+"${ENVS[@]}"}; do E+=(-e "$v"); done
    for k in ${KEYNAMES[@]+"${KEYNAMES[@]}"}; do E+=(-e "$k"); done
    G=(); [ $GPU = 1 ] && G=(--gpus all)
    T=(-i); [ -t 0 ] && [ -t 1 ] && T=(-it)
    ID=(--user "$(id -u):$(id -g)"); [ "$RUNTIME" = podman ] && [ "$(id -u)" != 0 ] && ID=(--userns=keep-id --user "$(id -u):$(id -g)")
    exec "$RUNTIME_BIN" run --rm ${T[@]+"${T[@]}"} "${ID[@]}" --network host -w /tmp ${G[@]+"${G[@]}"} ${B[@]+"${B[@]}"} ${E[@]+"${E[@]}"} "$IMAGE" "$@";;
  *) die "unknown runtime $RUNTIME";;
esac
