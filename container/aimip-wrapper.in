#!/bin/bash
# AIMIP host wrapper — generated by install/install-container.sh (values below are filled at install time; do not edit
# by hand, re-run install-container.sh instead). Runs the `aimip` CLI inside the container image; mounts paths
# read-only except the run directory, the caller's run root, and (when writable) the data directory.
set -u
export LC_ALL=C   # stable `ls -ld` mode columns for the permission checks below
umask g-w,o-w     # run directories created through the wrapper must pass trusted_dir even for users with umask 002
PREFIX=@PREFIX@
RUNTIME=@RUNTIME@            # apptainer | singularity | docker | podman
RUNTIME_BIN=@RUNTIME_BIN@
IMAGE=@IMAGE@                # SIF path or docker/podman tag
SCHEDULER=@SCHEDULER@        # slurm | none
RUN_ROOT_TEMPLATE='@RUN_ROOT@'
EXTRA_RO="@EXTRA_RO@"
DATA=$PREFIX/data
U=$(id -un); U1=${U:0:1}
RUN_ROOT=${RUN_ROOT_TEMPLATE//'${USER}'/$U}; RUN_ROOT=${RUN_ROOT//'${U1}'/$U1}; RUN_ROOT=${RUN_ROOT//'${HOME}'/$HOME}
STATE_DIR=${AIMIP_STATE:-$RUN_ROOT/.aimip-state}

die() { echo "aimip: $*" >&2; exit 2; }
safe_path() {
  case "$1" in /*) ;; *) die "path must be absolute: $1";; esac
  case "$1" in *..*|*[!A-Za-z0-9._/+-]*) die "refusing path: $1";; esac
}
scrub_host_secrets() {
  unset GEMINI_API_KEY GOOGLE_API_KEY AIMIP_GEMINI_KEY_FILE AIMIP_GEMINI_VERTEX_TOKEN_FILE \
        AIMIP_GEMINI_VERTEX_PROJECT AIMIP_GEMINI_VERTEX_LOCATION GOOGLE_APPLICATION_CREDENTIALS \
        GOOGLE_CLOUD_PROJECT GCLOUD_PROJECT CLOUDSDK_AUTH_ACCESS_TOKEN OPENAI_API_KEY ANTHROPIC_API_KEY \
        LANGCHAIN_API_KEY LANGCHAIN_TRACING_V2 LANGSMITH_API_KEY \
        APPTAINERENV_GEMINI_API_KEY APPTAINERENV_GOOGLE_API_KEY \
        SINGULARITYENV_GEMINI_API_KEY SINGULARITYENV_GOOGLE_API_KEY
}
trusted_dir() {  # a run directory read again at job time must be the caller's own, a real directory, not group/world-writable
  local d=$1 m
  [ -L "$d" ] && die "refusing a symlinked run directory: $d"
  [ -d "$d" ] || die "not a directory: $d"
  [ -O "$d" ] || die "run directory is not owned by you: $d"
  m=$(ls -ld "$d" | cut -c1-10)
  case "${m:5:1}${m:8:1}" in *w*) die "run directory is group- or world-writable ($m): $d — fix with: chmod go-w $d";; esac
  for f in job.sbatch config.yaml emu-job.json ic_era5.pt aimip-manifest.json spin-manifest.json plan.json submit-intent.json cancel-requested.txt experiment.yaml .submit.lock slurm.jobid sacct.txt local.pid local-run.log ic_members.nc ic_members_atmosphere.nc ic_members_ocean.nc; do
    [ -L "$d/$f" ] && die "refusing symlinked $d/$f"
    [ -e "$d/$f" ] || continue
    [ -O "$d/$f" ] || die "$d/$f is not owned by you"
    m=$(ls -ld "$d/$f" | cut -c1-10)
    case "${m:5:1}${m:8:1}" in *w*) die "$d/$f is group- or world-writable ($m) — fix with: chmod go-w $d/$f";; esac
  done
  # ancestry: no directory above the run dir may let others rename it away (group/world-writable without sticky bit)
  check_ancestry "$d"
  # check the resolved physical path too so a symlink in the path cannot lead into a shared writable tree
  local phys; phys=$(cd "$d" 2>/dev/null && pwd -P) || die "cannot resolve $d"
  [ "$phys" = "$d" ] || check_ancestry "$phys"
  return 0
}
check_ancestry() {
  local a=$1 o m
  while a=$(dirname "$a"); [ "$a" != / ]; do
    if [ -L "$a" ]; then   # system links (e.g. /var -> /private/var) are fine; a link owned by another user is not
      o=$(ls -ld "$a" | awk '{print $3}'); [ "$o" = root ] || [ "$o" = "$U" ] || die "a symlink owned by $o is in the run directory path: $a"
      continue
    fi
    m=$(ls -ld "$a" | cut -c1-10)
    case "${m:5:1}${m:8:1}" in *w*) case "${m:9:1}" in t|T) ;; *) die "a parent directory is writable by others without sticky bit ($m): $a";; esac;; esac
  done
  return 0
}
write_in_dir() {  # write_in_dir <trusted dir> <name> <content>: tmp + mv, never through a symlink
  local t; t=$(mktemp "$1/.$2.XXXXXX") || die "cannot write in $1"; printf '%s\n' "$3" > "$t"; mv -f "$t" "$1/$2"
}
check_job_script() {  # the job script must match the exact shape generated by aimip (literal comparison, no regex on $PREFIX)
  local f=$1 d=$2 n=0 execs=0 line rest log_rel log_pfx log_sfx cand cand_mid
  local want_exec="\"$PREFIX/bin/aimip\" exec-fme \""
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n+1))
    if [ $n = 1 ]; then [ "$line" = "#!/bin/bash" ] || die "line 1 must be #!/bin/bash"; continue; fi
    if [ $n = 2 ]; then [ "$line" = "# aimip-generated v1" ] || die "$f is not an aimip-generated script"; continue; fi
    case "$line" in
      "") ;;
      "set -euo pipefail") ;;
      "#SBATCH --hint=nomultithread") ;;   # one task CPU per physical core; no other --hint value is generated
      "#SBATCH --"*)
        rest=${line#"#SBATCH --"}
        case "$rest" in *=*) ;; *) die "unexpected #SBATCH line: $line";; esac
        case "${rest%%=*}" in job-name|partition|account|gres|cpus-per-task|mem|time|output|error) ;; *) die "unexpected #SBATCH line: $line";; esac
        case "${rest#*=}" in ""|*..*|*[!A-Za-z0-9._/:%+-]*) die "unexpected #SBATCH value: $line";; esac
        case "${rest%%=*}" in output|error)
          case "${rest#*=}" in "$d"/*) ;; *) die "slurm log outside the run directory: $line";; esac
          log_rel=${rest#*=}; log_rel=${log_rel#"$d"/}
          case "$log_rel" in ""|.|*/*) die "slurm log must be a file directly in the run directory: $line";; esac
          [ -L "$d/$log_rel" ] && die "refusing symlinked slurm log: $d/$log_rel"
          [ -d "$d/$log_rel" ] && die "slurm log destination is a directory: $d/$log_rel"
          case "$log_rel" in
            *%*)
              case "$log_rel" in *%j*) ;; *) die "unsupported slurm log substitution: $line";; esac
              log_pfx=${log_rel%%"%j"*}; log_sfx=${log_rel#*"%j"}
              case "$log_pfx$log_sfx" in *%*) die "unsupported slurm log substitution: $line";; esac
              for cand in "$d/$log_pfx"*"$log_sfx"; do
                [ -L "$cand" ] || [ -e "$cand" ] || continue
                cand_mid=${cand#"$d/$log_pfx"}; cand_mid=${cand_mid%"$log_sfx"}
                case "$cand_mid" in ""|*[!0-9]*) continue;; esac
                [ -L "$cand" ] && die "refusing symlinked slurm log: $cand"
                [ -d "$cand" ] && die "slurm log destination is a directory: $cand"
              done;;
          esac;;
        esac;;
      "$want_exec"*)
        rest=${line#"$want_exec"}
        case "$rest" in /*\") ;; *) die "unexpected exec line: $line";; esac
        rest=${rest%\"}; safe_path "$rest"
        [ "$rest" = "$d" ] || case "$rest" in "$d"/*) ;; *) die "exec target outside the run directory: $rest";; esac
        execs=$((execs+1));;
      *) die "$f has an unexpected line: $line";;
    esac
  done < "$f"
  [ $execs -ge 1 ] || die "$f has no exec-fme line"
}

resolve_target() {  # bare run name (demo) -> $RUN_ROOT/demo; otherwise require safe absolute path
  case "$1" in
    */*) safe_path "$1"; printf '%s\n' "${1%/}";;
    [A-Za-z0-9]*)
      case "$1" in *[!A-Za-z0-9._-]*) die "refusing run name: $1";; esac
      safe_path "$RUN_ROOT/$1"; printf '%s\n' "$RUN_ROOT/$1";;
    *) safe_path "$1";;
  esac
}

reconcile_squeue_by_nonce() {  # reconcile_squeue_by_nonce <job_name> <attempt_nonce>; prints jobid on exact unique match
  local jname=$1 nonce=$2 sq_out line f_id f_name f_st f_com matches=0 found_id=""
  case "$nonce" in aimip-attempt-[0-9a-f]*) ;; *) return 1;; esac
  command -v squeue >/dev/null 2>&1 || return 2
  sq_out=$(squeue --noheader -u "$U" -n "$jname" -o '%i|%j|%T|%k' 2>/dev/null) || return 2
  while IFS= read -r line || [ -n "$line" ]; do
    [ -n "$line" ] || continue
    f_id=${line%%|*}; line=${line#*|}
    f_name=${line%%|*}; line=${line#*|}
    f_st=${line%%|*}; f_com=${line#*|}
    case "$f_id" in ""|*[!0-9]*) continue;; esac
    if [ "$f_name" = "$jname" ] && [ "$f_com" = "$nonce" ]; then
      matches=$((matches+1)); found_id=$f_id
    fi
  done <<EOF
$sq_out
EOF
  [ "$matches" = 1 ] && { printf '%s\n' "$found_id"; return 0; }
  return 1
}

verify_submit_in_container() {  # verify_submit_in_container <run_dir> <priv_dir> <priv_script> <expect_digest>
  local d=$1 pd=$2 priv_s=$3 exp_dig=$4 img_sha m v e
  local -a vmounts venvs vcmd vb ve vid
  vmounts=("$PREFIX:$PREFIX:ro" "$pd:$pd:ro")
  [ -d "$DATA" ] && vmounts+=("$DATA:$DATA:ro")
  [ -d "$RUN_ROOT" ] && vmounts+=("$RUN_ROOT:$RUN_ROOT:ro")
  case "$d" in "$RUN_ROOT"/*) ;; *) vmounts+=("$d:$d:ro");; esac
  [ -d "$STATE_DIR" ] && case "$STATE_DIR" in "$RUN_ROOT"/*) ;; *) vmounts+=("$STATE_DIR:$STATE_DIR:ro");; esac
  for e in $EXTRA_RO; do [ -d "$e" ] && vmounts+=("$e:$e:ro"); done
  img_sha=$(cut -c1-64 "$PREFIX/image.sha256" 2>/dev/null || echo unknown)
  venvs=("AIMIP_HOME=$PREFIX" "AIMIP_PLAYGROUND=$PREFIX" "AIMIP_DATA=$DATA" "AIMIP_IMAGE_SHA=$img_sha"
         "AIMIP_DEFAULT_OUT_ROOT=$RUN_ROOT" "AIMIP_STATE=$STATE_DIR" "AIMIP_USER=$U"
         "AIMIP_SCHEDULER=$SCHEDULER" "AIMIP_SITE_CONFIG=$PREFIX/site.json" "AIMIP_EXTRA_RO_BINDS=$EXTRA_RO"
         "AIMIP_DATA_MODE=ro" "HOME=/tmp")
  vcmd=(verify-submit "$d" --script-path "$priv_s")
  [ -n "$exp_dig" ] && vcmd+=(--expect-digest "$exp_dig")
  vb=(); ve=()
  case "$RUNTIME" in
    apptainer|singularity)
      for m in ${vmounts[@]+"${vmounts[@]}"}; do vb+=(-B "$m"); done
      for v in ${venvs[@]+"${venvs[@]}"}; do ve+=(--env "$v"); done
      "$RUNTIME_BIN" -s exec --containall --cleanenv --no-home --pwd /tmp ${vb[@]+"${vb[@]}"} ${ve[@]+"${ve[@]}"} "$IMAGE" python -B -m aimip "${vcmd[@]}";;
    docker|podman)
      for m in ${vmounts[@]+"${vmounts[@]}"}; do vb+=(-v "$m"); done
      for v in ${venvs[@]+"${venvs[@]}"}; do ve+=(-e "$v"); done
      vid=(--user "$(id -u):$(id -g)")
      [ "$RUNTIME" = podman ] && [ "$(id -u)" != 0 ] && vid=(--userns=keep-id --user "$(id -u):$(id -g)")
      "$RUNTIME_BIN" run --rm -i "${vid[@]}" --network none -w /tmp ${vb[@]+"${vb[@]}"} ${ve[@]+"${ve[@]}"} "$IMAGE" "${vcmd[@]}";;
    *) return 2;;
  esac
}

# ---------------- host-side commands ----------------
if [ "${1:-}" = "submit" ]; then
  scrub_host_secrets
  D=""; WANT_JSON=0; EXPECT_DIGEST=""
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) WANT_JSON=1; shift;;
      --expect-digest=*) EXPECT_DIGEST=${1#--expect-digest=}; shift;;
      --expect-digest) [ $# -ge 2 ] || die "--expect-digest requires a hex digest"; EXPECT_DIGEST=$2; shift 2;;
      -*) die "unsupported option for host submit: $1";;
      *) [ -z "$D" ] && D=$1 || die "usage: aimip submit [--expect-digest HEX] <run-dir-or-name> [--json]"; shift;;
    esac
  done
  [ -n "$D" ] || die "usage: aimip submit <run-dir-or-name>"
  D=$(resolve_target "$D") || exit 2
  trusted_dir "$D"
  [ -f "$D/job.sbatch" ] || die "$D has no job.sbatch (prepare it with: aimip run ... --out $D)"

  # Per-run serialization lock
  LOCK_DIR=""; USE_FLOCK=0
  [ -L "$D/.submit.lock" ] && die "refusing symlinked $D/.submit.lock"
  if command -v flock >/dev/null 2>&1; then
    exec 9>"$D/.submit.lock" || die "cannot open $D/.submit.lock"
    chmod 600 "$D/.submit.lock" 2>/dev/null || true
    flock -x 9 || die "cannot lock $D/.submit.lock"
    USE_FLOCK=1
  else
    LOCK_DIR="$D/.submit.lockdir"
    [ -L "$LOCK_DIR" ] && die "refusing symlinked $LOCK_DIR"
    mkdir "$LOCK_DIR" 2>/dev/null || die "concurrent submission in progress for $D"
  fi
  PD=""
  cleanup_submit() {
    [ -n "$PD" ] && rm -rf "$PD"
    [ -n "$LOCK_DIR" ] && rmdir "$LOCK_DIR" 2>/dev/null || true
  }
  trap 'cleanup_submit' EXIT

  [ -e "$D/slurm.jobid" ] || [ -e "$D/local.pid" ] && die "already submitted"
  # Copy into a fresh caller-private 0700 directory, validate the copy, and submit the copy so the checked file
  # cannot be swapped before sbatch or bash reads it.
  PD=$(mktemp -d "${TMPDIR:-/tmp}/aimip-submit.XXXXXX") || die "cannot create a private directory"
  chmod 700 "$PD"; T=$PD/job.sbatch
  cat "$D/job.sbatch" > "$T" || die "cannot read $D/job.sbatch"; chmod 400 "$T"
  check_job_script "$T" "$D"

  EFF_SCHED=$SCHEDULER
  VERIFIED_DIGEST=""
  if [ -e "$D/plan.json" ] || [ -e "$D/aimip-manifest.json" ] || [ -n "$EXPECT_DIGEST" ]; then
    vout=$(verify_submit_in_container "$D" "$PD" "$T" "$EXPECT_DIGEST" 2>"$PD/verify.err")
    vrc=$?
    if [ $vrc != 0 ]; then
      verr=$(cat "$PD/verify.err" 2>/dev/null || echo "plan verification failed")
      if [ "$WANT_JSON" = 1 ]; then
        printf '%s\n' "$verr" >&2
        printf '{"aimip":"1","ok":false,"error":{"type":"ApprovalError","field":"digest","message":"Host submit verification failed; approve again."}}\n'
      else
        printf '%s\n' "$verr" >&2
      fi
      exit $vrc
    fi
    VERIFIED_DIGEST=${vout%%|*}
    vrest=${vout#*|}
    vmode=${vrest%%|*}
    [ "$vmode" = "local" ] && EFF_SCHED=none
  fi

  if [ "$EFF_SCHED" = slurm ]; then
    JNAME=$(sed -n 's/^#SBATCH --job-name=//p' "$T" | head -n 1)
    [ -n "$JNAME" ] || JNAME=$(basename "$D")
    if [ -f "$D/submit-intent.json" ]; then
      pstate=$(sed -n 's/.*"state"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$D/submit-intent.json" | head -n 1)
      pnonce=$(sed -n 's/.*"attempt_nonce"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$D/submit-intent.json" | head -n 1)
      if [ "$pstate" = "submitting" ] || [ "$pstate" = "uncertain" ]; then
        if rec_id=$(reconcile_squeue_by_nonce "$JNAME" "$pnonce"); then
          write_in_dir "$D" slurm.jobid "$rec_id"
          write_in_dir "$D" submit-intent.json "{\"state\":\"reconciled\",\"run_dir\":\"$D\",\"job_name\":\"$JNAME\",\"user\":\"$U\",\"attempt_nonce\":\"$pnonce\",\"job_id\":\"$rec_id\"}"
          if [ "$WANT_JSON" = 1 ]; then
            printf '{"aimip":"1","ok":true,"result":{"out_dir":"%s","run_dir":"%s","scheduler":"slurm","slurm_job_id":"%s","local_pid":null,"log_path":null,"reconciled":true}}\n' "$D" "$D" "$rec_id"
          else
            echo "reconciled job $rec_id   (then: aimip status $D)"
          fi
          exit 0
        fi
        echo "aimip: previous submission for $D had an uncertain scheduler reply; refusing blind retry" >&2
        exit 1
      fi
    fi

    rand_hex=$(od -An -tx1 -N12 /dev/urandom 2>/dev/null | tr -d ' \n')
    [ -n "$rand_hex" ] || rand_hex="000000000000$$"
    attempt_nonce="aimip-attempt-$rand_hex"
    write_in_dir "$D" submit-intent.json "{\"state\":\"submitting\",\"run_dir\":\"$D\",\"job_name\":\"$JNAME\",\"user\":\"$U\",\"attempt_nonce\":\"$attempt_nonce\",\"digest\":\"$VERIFIED_DIGEST\"}"

    out=$(sbatch --parsable "--comment=$attempt_nonce" "$T" 2>"$PD/sbatch.err")
    sb_rc=$?
    sb_err=$(tr '\n' ' ' < "$PD/sbatch.err" 2>/dev/null || true)
    if [ $sb_rc != 0 ]; then
      low_err=$(printf '%s' "$sb_err" | tr '[:upper:]' '[:lower:]')
      case "$low_err" in
        *"socket timed out"*|*"slurm_receive_msg"*|*"unable to contact"*|*"transport endpoint"*)
          if rec_id=$(reconcile_squeue_by_nonce "$JNAME" "$attempt_nonce"); then
            write_in_dir "$D" slurm.jobid "$rec_id"
            write_in_dir "$D" submit-intent.json "{\"state\":\"reconciled\",\"run_dir\":\"$D\",\"job_name\":\"$JNAME\",\"user\":\"$U\",\"attempt_nonce\":\"$attempt_nonce\",\"job_id\":\"$rec_id\"}"
            if [ "$WANT_JSON" = 1 ]; then
              printf '{"aimip":"1","ok":true,"result":{"out_dir":"%s","run_dir":"%s","scheduler":"slurm","slurm_job_id":"%s","local_pid":null,"log_path":null,"reconciled":true}}\n' "$D" "$D" "$rec_id"
            else
              echo "reconciled job $rec_id   (then: aimip status $D)"
            fi
            exit 0
          fi
          write_in_dir "$D" submit-intent.json "{\"state\":\"uncertain\",\"run_dir\":\"$D\",\"job_name\":\"$JNAME\",\"user\":\"$U\",\"attempt_nonce\":\"$attempt_nonce\"}"
          echo "aimip: uncertain scheduler reply ($sb_err); recorded submit-intent.json and refusing blind retry" >&2
          exit 1;;
        *)
          write_in_dir "$D" submit-intent.json "{\"state\":\"failed_before_submit\",\"run_dir\":\"$D\",\"job_name\":\"$JNAME\",\"user\":\"$U\",\"attempt_nonce\":\"$attempt_nonce\"}"
          die "sbatch failed${sb_err:+: $sb_err}";;
      esac
    fi
    jid=${out%%;*}; jid=$(printf '%s' "$jid" | tr -d '[:space:]')
    case "$jid" in
      ""|*[!0-9]*)
        if rec_id=$(reconcile_squeue_by_nonce "$JNAME" "$attempt_nonce"); then
          jid=$rec_id
        else
          write_in_dir "$D" submit-intent.json "{\"state\":\"uncertain\",\"run_dir\":\"$D\",\"job_name\":\"$JNAME\",\"user\":\"$U\",\"attempt_nonce\":\"$attempt_nonce\"}"
          echo "aimip: sbatch returned non-numeric job ID ($out); recorded uncertain intent" >&2
          exit 1
        fi;;
    esac
    write_in_dir "$D" slurm.jobid "$jid"
    write_in_dir "$D" submit-intent.json "{\"state\":\"submitted\",\"run_dir\":\"$D\",\"job_name\":\"$JNAME\",\"user\":\"$U\",\"attempt_nonce\":\"$attempt_nonce\",\"job_id\":\"$jid\"}"
    if [ "$WANT_JSON" = 1 ]; then
      printf '{"aimip":"1","ok":true,"result":{"out_dir":"%s","run_dir":"%s","scheduler":"slurm","slurm_job_id":"%s","local_pid":null,"log_path":null,"reconciled":false}}\n' "$D" "$D" "$jid"
    else
      echo "submitted job $jid   (then: aimip status $D  or: aimip watch $(basename "$D"))"
    fi
  else
    PD_KEEP=$PD; PD=""   # local runs execute the private copy in the background until completion
    [ -L "$D/local-run.log" ] && die "refusing symlinked $D/local-run.log"
    nohup bash "$PD_KEEP/job.sbatch" > "$D/local-run.log" 2>&1 & write_in_dir "$D" local.pid "$!"
    lpid=$(cat "$D/local.pid")
    if [ "$WANT_JSON" = 1 ]; then
      printf '{"aimip":"1","ok":true,"result":{"out_dir":"%s","run_dir":"%s","scheduler":"none","slurm_job_id":null,"local_pid":%s,"log_path":"%s/local-run.log"}}\n' "$D" "$D" "$lpid" "$D"
    else
      echo "started locally, pid $lpid   (log: $D/local-run.log)"
    fi
  fi
  exit 0
fi

if [ "${1:-}" = "cancel" ] && [ -n "${2:-}" ]; then
  scrub_host_secrets
  CD=""; WANT_JSON=0
  for a in "${@:2}"; do case "$a" in --json) WANT_JSON=1;; -*) ;; *) [ -z "$CD" ] && CD=$a;; esac; done
  if [ -n "$CD" ]; then
    CD=$(resolve_target "$CD") || exit 2
    trusted_dir "$CD"
    if [ "$SCHEDULER" = slurm ] && [ -f "$CD/slurm.jobid" ]; then
      j=$(tr -dc '0-9' < "$CD/slurm.jobid")
      [ -n "$j" ] || die "invalid slurm.jobid in $CD"
      sa_st=$(sacct -n -X -P -j "$j" -o State 2>/dev/null | head -n 1 | awk '{print $1}')
      [ -n "$sa_st" ] || [ ! -f "$CD/sacct.txt" ] || sa_st=$(cut -d'|' -f2 "$CD/sacct.txt" 2>/dev/null | head -n 1 | awk '{print $1}')
      case "${sa_st%+}" in
        COMPLETED|FAILED|CANCELLED*|TIMEOUT|OUT_OF_MEMORY|NODE_FAIL|PREEMPTED|BOOT_FAIL|DEADLINE)
          die "run $CD is already in terminal state $sa_st and cannot be cancelled";;
      esac
      scancel "$j" || die "scancel $j failed"
      write_in_dir "$CD" cancel-requested.txt "job=$j requested_by=$U"
      if [ "$WANT_JSON" = 1 ]; then
        printf '{"aimip":"1","ok":true,"result":{"run_dir":"%s","scheduler":"slurm","attempt_id":"%s","cancelled":true,"status":"cancel_requested"}}\n' "$CD" "$j"
      else
        echo "cancel requested for job $j ($CD)"
      fi
      exit 0
    elif [ -f "$CD/local.pid" ]; then
      lpid=$(tr -dc '0-9' < "$CD/local.pid")
      [ -n "$lpid" ] && [ "$lpid" -gt 1 ] || die "invalid local.pid in $CD"
      if kill -TERM "$lpid" 2>/dev/null; then
        write_in_dir "$CD" cancel-requested.txt "pid=$lpid requested_by=$U"
        if [ "$WANT_JSON" = 1 ]; then
          printf '{"aimip":"1","ok":true,"result":{"run_dir":"%s","scheduler":"none","attempt_id":"%s","cancelled":true,"status":"cancel_requested"}}\n' "$CD" "$lpid"
        else
          echo "cancel requested for local pid $lpid ($CD)"
        fi
        exit 0
      else
        echo "aimip: local process $lpid for $CD not found (already exited)" >&2
        exit 1
      fi
    fi
  fi
fi

refresh_active_runs_sacct() {
  [ "$SCHEDULER" = slurm ] && [ -d "$RUN_ROOT" ] && command -v sacct >/dev/null 2>&1 || return 0
  local d j jlist="" prev_st sa_all idx=0 n_active=0 one_d one_j sa_one
  local -a dirs=() jids=()
  for d in "$RUN_ROOT"/*; do
    [ -d "$d" ] && [ ! -L "$d" ] && [ -f "$d/slurm.jobid" ] || continue
    if [ -f "$d/aimip-manifest.json" ] && grep -q '"finished"[[:space:]]*:' "$d/aimip-manifest.json" 2>/dev/null; then
      continue
    fi
    if [ -f "$d/sacct.txt" ]; then
      prev_st=$(cut -d'|' -f2 "$d/sacct.txt" 2>/dev/null | head -n 1 | awk '{print $1}')
      case "${prev_st%+}" in
        COMPLETED|FAILED|CANCELLED*|TIMEOUT|OUT_OF_MEMORY|NODE_FAIL|PREEMPTED|BOOT_FAIL|DEADLINE)
          continue;;
      esac
    fi
    ( trusted_dir "$d" ) 2>/dev/null || continue
    j=$(tr -dc '0-9' < "$d/slurm.jobid")
    [ -n "$j" ] || continue
    dirs[$n_active]="$d"
    jids[$n_active]="$j"
    n_active=$((n_active + 1))
    jlist="${jlist:+$jlist,}$j"
  done
  [ "$n_active" -gt 0 ] || return 0
  sa_all=$( ( scrub_host_secrets; sacct -n -X -P -j "$jlist" -o JobID,State,Elapsed,ExitCode ) 2>/dev/null || true )
  [ -n "$sa_all" ] || return 0
  for ((idx=0; idx<n_active; idx++)); do
    one_d="${dirs[$idx]}"; one_j="${jids[$idx]}"
    sa_one=$(printf '%s\n' "$sa_all" | awk -F'|' -v j="$one_j" '$1==j || index($1, j".")==1 {print}')
    [ -n "$sa_one" ] && write_in_dir "$one_d" sacct.txt "$sa_one"
  done
}

REFRESH_BG_PID=""
SACCT_POLL_SEC=${AIMIP_WRAPPER_SACCT_INTERVAL:-15}
cleanup_refresh_bg() {
  if [ -n "$REFRESH_BG_PID" ]; then
    pkill -P "$REFRESH_BG_PID" 2>/dev/null || true
    kill "$REFRESH_BG_PID" 2>/dev/null || true
    wait "$REFRESH_BG_PID" 2>/dev/null || true
  fi
}

if { [ "${1:-}" = "status" ] || [ "${1:-}" = "watch" ] || [ "${1:-}" = "logs" ]; } && [ -n "${2:-}" ] && [ "$SCHEDULER" = slurm ]; then
  SD=$(resolve_target "$2" 2>/dev/null || true)
  if [ -n "$SD" ] && [ -f "$SD/slurm.jobid" ] && ( trusted_dir "$SD" ) 2>/dev/null; then
    j=$(tr -dc '0-9' < "$SD/slurm.jobid")
    if [ -n "$j" ] && command -v sacct >/dev/null 2>&1; then
      sa=$( ( scrub_host_secrets; sacct -n -X -P -j "$j" -o JobID,State,Elapsed,ExitCode ) 2>/dev/null )
      [ -n "$sa" ] && write_in_dir "$SD" sacct.txt "$sa"
      WANT_FOLLOW=0
      [ "${1:-}" = "watch" ] && WANT_FOLLOW=1
      if [ "${1:-}" = "logs" ]; then
        for a in "${@:2}"; do case "$a" in -f|--follow) WANT_FOLLOW=1;; esac; done
      fi
      if [ "$WANT_FOLLOW" = 1 ] && [ "${SACCT_POLL_SEC}" -gt 0 ] 2>/dev/null; then
        ( scrub_host_secrets
          spid=""
          trap '[ -n "$spid" ] && kill "$spid" 2>/dev/null || true; exit 0' TERM INT HUP
          while :; do
            sleep "$SACCT_POLL_SEC" &
            spid=$!
            wait "$spid" 2>/dev/null || exit 0
            sa_loop=$(sacct -n -X -P -j "$j" -o JobID,State,Elapsed,ExitCode 2>/dev/null || true)
            [ -n "$sa_loop" ] && write_in_dir "$SD" sacct.txt "$sa_loop"
          done ) </dev/null >/dev/null 2>&1 &
        REFRESH_BG_PID=$!
        trap 'cleanup_refresh_bg' EXIT
      fi
    fi
  fi
elif [ "${1:-}" = "ls" ] && [ "$SCHEDULER" = slurm ]; then
  refresh_active_runs_sacct
elif [ "${1:-}" = "ui" ] && [ "$SCHEDULER" = slurm ] && command -v sacct >/dev/null 2>&1; then
  refresh_active_runs_sacct
  if [ "${SACCT_POLL_SEC}" -gt 0 ] 2>/dev/null; then
    ( scrub_host_secrets
      spid=""
      trap '[ -n "$spid" ] && kill "$spid" 2>/dev/null || true; exit 0' TERM INT HUP
      while :; do
        sleep "$SACCT_POLL_SEC" &
        spid=$!
        wait "$spid" 2>/dev/null || exit 0
        refresh_active_runs_sacct
      done ) </dev/null >/dev/null 2>&1 &
    REFRESH_BG_PID=$!
    trap 'cleanup_refresh_bg' EXIT
  fi
fi

# ---------------- container commands ----------------
RW=()
args=("$@"); n=${#args[@]}
for ((i=0; i<n; i++)); do
  case "${args[$i]}" in
    --out|--ocean-out) [ $((i+1)) -lt $n ] && RW+=("${args[$((i+1))]}");;
    --out=*) RW+=("${args[$i]#--out=}");;
    --ocean-out=*) RW+=("${args[$i]#--ocean-out=}");;
  esac
done
case "${1:-}" in exec-fme|status|watch|logs|cancel|summary|collect|ls) case "${2:-}" in /*) RW+=("$2");; esac;; esac
# At job time the run directory is read again (config.yaml, manifest): verify it is still safely the caller's.
[ "${1:-}" = "exec-fme" ] && { [ -n "${2:-}" ] || die "usage: aimip exec-fme <run-dir>"; safe_path "$2"; trusted_dir "${2%/}"; }
mkdir -p "$RUN_ROOT" 2>/dev/null || true

declare -a MOUNTS=()   # "src:dst:mode"
MOUNTS+=("$PREFIX:$PREFIX:ro")
# data: rw for setup/fetch, and for run/ic/chat/mcp/ui when the caller may write it;
# non-writable callers see it read-only and are told up front to have `aimip fetch -m <model>` run first.
DATA_MODE=ro
case "${1:-}" in
  setup|fetch) mkdir -p "$DATA" 2>/dev/null; [ -w "$DATA" ] || die "$DATA is not writable by you: ask the install owner to run this"; DATA_MODE=rw;;
  run|ic|chat|mcp|ui) mkdir -p "$DATA" 2>/dev/null || true; [ -w "$DATA" ] && DATA_MODE=rw;;
esac
[ -d "$DATA" ] && [ $DATA_MODE = rw ] && MOUNTS+=("$DATA:$DATA:rw")
[ -d "$RUN_ROOT" ] && MOUNTS+=("$RUN_ROOT:$RUN_ROOT:rw")
for e in $EXTRA_RO; do [ -d "$e" ] && MOUNTS+=("$e:$e:ro"); done
for d in ${RW[@]+"${RW[@]}"}; do
  safe_path "$d"
  case "$d" in "$RUN_ROOT"/*) continue;; esac
  base=$d; [ -e "$base" ] || base=$(dirname "$base"); mkdir -p "$base" 2>/dev/null || true
  [ -w "$base" ] || die "not writable: $base"
  MOUNTS+=("$base:$base:rw")
done
KEYENV=(); KEYNAMES=()   # credentials are forwarded only for `chat` or `ui`, and never as KEY=value in argv
if [ "${1:-}" = "chat" ] || [ "${1:-}" = "ui" ]; then
  for v in AIMIP_AGENT_MODEL AIMIP_GEMINI_VERTEX_PROJECT AIMIP_GEMINI_VERTEX_LOCATION; do
    val=${!v:-}
    [ -n "$val" ] && KEYENV+=("$v=${val//,/;}")
  done
  for k in GEMINI_API_KEY GOOGLE_API_KEY; do
    [ -n "${!k:-}" ] || continue
    KEYNAMES+=("$k"); export "APPTAINERENV_$k=${!k}" "SINGULARITYENV_$k=${!k}"
  done
  if [ -n "${AIMIP_GEMINI_KEY_FILE:-}" ]; then safe_path "$AIMIP_GEMINI_KEY_FILE"
    [ -f "$AIMIP_GEMINI_KEY_FILE" ] && [ ! -L "$AIMIP_GEMINI_KEY_FILE" ] && [ -O "$AIMIP_GEMINI_KEY_FILE" ] \
      || die "AIMIP_GEMINI_KEY_FILE must be an existing regular file owned by you: $AIMIP_GEMINI_KEY_FILE"
    MOUNTS+=("$AIMIP_GEMINI_KEY_FILE:$AIMIP_GEMINI_KEY_FILE:ro"); KEYENV+=("AIMIP_GEMINI_KEY_FILE=$AIMIP_GEMINI_KEY_FILE"); fi
  for f in AIMIP_GEMINI_VERTEX_TOKEN_FILE GOOGLE_APPLICATION_CREDENTIALS; do
    [ -n "${!f:-}" ] || continue; safe_path "${!f}"
    [ -f "${!f}" ] && [ ! -L "${!f}" ] && [ -O "${!f}" ] || die "$f must be an existing regular file owned by you: ${!f}"
    MOUNTS+=("${!f}:${!f}:ro"); KEYENV+=("$f=${!f}")
  done
fi

DOCENV=()
if [ "${1:-}" = "doctor" ] || [ "${1:-}" = "ui" ]; then
  if { [ -x "$RUNTIME_BIN" ] || command -v "$RUNTIME_BIN" >/dev/null 2>&1; } && { [ "$RUNTIME" = docker ] || [ "$RUNTIME" = podman ] || [ -f "$IMAGE" ]; }; then
    DOCENV+=("AIMIP_HOST_RUNTIME_OK=1" "AIMIP_HOST_RUNTIME_DETAIL=$RUNTIME_BIN; image=$IMAGE")
  else
    DOCENV+=("AIMIP_HOST_RUNTIME_OK=0" "AIMIP_HOST_RUNTIME_DETAIL=missing $RUNTIME_BIN or $IMAGE on host")
  fi
  if [ "$SCHEDULER" = slurm ]; then
    miss_slurm=""
    for sb in sbatch squeue sacct scancel; do
      command -v "$sb" >/dev/null 2>&1 || miss_slurm="${miss_slurm:+$miss_slurm; }$sb"
    done
    if [ -z "$miss_slurm" ]; then
      DOCENV+=("AIMIP_HOST_SLURM_OK=1")
    else
      DOCENV+=("AIMIP_HOST_SLURM_OK=0" "AIMIP_HOST_SLURM_MISSING=$miss_slurm")
    fi
  fi
  if command -v nvidia-smi >/dev/null 2>&1 && gpu_line=$(nvidia-smi -L 2>/dev/null | head -n 1 | tr ',' ';') && [ -n "$gpu_line" ]; then
    DOCENV+=("AIMIP_HOST_GPU_STATUS=present" "AIMIP_HOST_GPU_LINE=$gpu_line")
  else
    DOCENV+=("AIMIP_HOST_GPU_STATUS=absent")
  fi
fi

case "$STATE_DIR" in "$RUN_ROOT"/*) ;; *) safe_path "$STATE_DIR"; mkdir -p "$STATE_DIR" 2>/dev/null || true; [ -d "$STATE_DIR" ] && MOUNTS+=("$STATE_DIR:$STATE_DIR:rw");; esac
IMG_SHA=$(cut -c1-64 "$PREFIX/image.sha256" 2>/dev/null || echo unknown)
OMP_SAFE=${OMP_NUM_THREADS:-16}; OMP_SAFE=${OMP_SAFE//,/;}
ENVS=("AIMIP_HOME=$PREFIX" "AIMIP_PLAYGROUND=$PREFIX" "AIMIP_DATA=$DATA" "AIMIP_IMAGE_SHA=$IMG_SHA" "AIMIP_DEFAULT_OUT_ROOT=$RUN_ROOT" "AIMIP_STATE=$STATE_DIR"
      "AIMIP_USER=$U" "AIMIP_SCHEDULER=$SCHEDULER" "AIMIP_SITE_CONFIG=$PREFIX/site.json" "AIMIP_EXTRA_RO_BINDS=$EXTRA_RO" "AIMIP_DATA_MODE=$DATA_MODE" "AIMIP_CHAT_LOG_DIR=$RUN_ROOT/chat-logs" "HOME=/tmp" "HF_HOME=$DATA/.hf" "OMP_NUM_THREADS=$OMP_SAFE" ${KEYENV[@]+"${KEYENV[@]}"} ${DOCENV[@]+"${DOCENV[@]}"})

GPU=0; command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1 && GPU=1
run_main_container() {
  case "$RUNTIME" in
    apptainer|singularity)
      B=(); for m in ${MOUNTS[@]+"${MOUNTS[@]}"}; do B+=(-B "$m"); done
      E=(); for v in ${ENVS[@]+"${ENVS[@]}"}; do E+=(--env "${v//,/;}" ); done
      NV=(); [ $GPU = 1 ] && NV=(--nv)
      if [ -n "$REFRESH_BG_PID" ]; then
        "$RUNTIME_BIN" -s exec ${NV[@]+"${NV[@]}"} --containall --cleanenv --no-home --pwd /tmp ${B[@]+"${B[@]}"} ${E[@]+"${E[@]}"} "$IMAGE" python -B -m aimip "$@"
        exit $?
      fi
      exec "$RUNTIME_BIN" -s exec ${NV[@]+"${NV[@]}"} --containall --cleanenv --no-home --pwd /tmp ${B[@]+"${B[@]}"} ${E[@]+"${E[@]}"} "$IMAGE" python -B -m aimip "$@";;
    docker|podman)
      B=(); for m in ${MOUNTS[@]+"${MOUNTS[@]}"}; do B+=(-v "$m"); done
      E=(); for v in ${ENVS[@]+"${ENVS[@]}"}; do E+=(-e "$v"); done
      for k in ${KEYNAMES[@]+"${KEYNAMES[@]}"}; do E+=(-e "$k"); done
      G=(); [ $GPU = 1 ] && G=(--gpus all)
      T=(-i); [ -t 0 ] && [ -t 1 ] && T=(-it)
      ID=(--user "$(id -u):$(id -g)"); [ "$RUNTIME" = podman ] && [ "$(id -u)" != 0 ] && ID=(--userns=keep-id --user "$(id -u):$(id -g)")
      if [ -n "$REFRESH_BG_PID" ]; then
        "$RUNTIME_BIN" run --rm ${T[@]+"${T[@]}"} "${ID[@]}" --network host -w /tmp ${G[@]+"${G[@]}"} ${B[@]+"${B[@]}"} ${E[@]+"${E[@]}"} "$IMAGE" "$@"
        exit $?
      fi
      exec "$RUNTIME_BIN" run --rm ${T[@]+"${T[@]}"} "${ID[@]}" --network host -w /tmp ${G[@]+"${G[@]}"} ${B[@]+"${B[@]}"} ${E[@]+"${E[@]}"} "$IMAGE" "$@";;
    *) die "unknown runtime $RUNTIME";;
  esac
}
run_main_container "$@"
